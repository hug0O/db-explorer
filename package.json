{
  "name": "db-explorer-Multi-SQL",
  "displayName": "DB Explorer Multi-SQL",
  "description": "%ext.description%",
  "version": "0.35.2",
  "publisher": "hugo0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:sql",
    "onView:dbexplorer.connections",
    "onView:dbexplorer.connectionForm",
    "onView:dbexplorer.helpPanel",
    "onView:dbexplorer.results",
    "onView:dbexplorer.settingsPanel",
    "onView:dbexplorer.library"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbexplorer",
          "title": "DB Explorer",
          "icon": "media/dbexplorer.svg"
        }
      ],
      "panel": [
        {
          "id": "dbexplorerPanel",
          "title": "DB Explorer",
          "icon": "media/dbexplorer.svg"
        }
      ]
    },
    "views": {
      "dbexplorer": [
        {
          "id": "dbexplorer.connections",
          "name": "Schema Browser",
          "when": "dbexplorer.sideTab != 'connection'"
        },
        {
          "id": "dbexplorer.connectionForm",
          "name": "%view.setup%",
          "type": "webview",
          "when": "dbexplorer.sideTab == 'connection'"
        },
        {
          "id": "dbexplorer.settingsPanel",
          "name": "%view.settingsTools%",
          "type": "webview",
          "visibility": "collapsed"
        },
        {
          "id": "dbexplorer.helpPanel",
          "name": "%view.help%",
          "type": "webview",
          "visibility": "collapsed"
        },
        {
          "id": "dbexplorer.library",
          "name": "%view.library%",
          "type": "webview",
          "visibility": "collapsed"
        }
      ],
      "dbexplorerPanel": [
        {
          "id": "dbexplorer.results",
          "name": "%view.results%",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dbexplorer.connections",
        "contents": "%welcome.connections%"
      }
    ],
    "commands": [
      {
        "command": "dbexplorer.addConnection",
        "title": "%cmd.addConnection%",
        "icon": "$(add)"
      },
      {
        "command": "dbexplorer.editConnection",
        "title": "%cmd.editConnection%"
      },
      {
        "command": "dbexplorer.removeConnection",
        "title": "%cmd.removeConnection%"
      },
      {
        "command": "dbexplorer.connect",
        "title": "%cmd.connect%"
      },
      {
        "command": "dbexplorer.disconnect",
        "title": "%cmd.disconnect%",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "dbexplorer.setActive",
        "title": "%cmd.setActive%",
        "icon": "$(plug)"
      },
      {
        "command": "dbexplorer.refresh",
        "title": "%cmd.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "dbexplorer.changeSchema",
        "title": "%cmd.changeSchema%",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "dbexplorer.newEditor",
        "title": "%cmd.newEditor%",
        "icon": "$(new-file)"
      },
      {
        "command": "dbexplorer.executeStatement",
        "title": "%cmd.executeStatement%",
        "icon": "$(play)"
      },
      {
        "command": "dbexplorer.executeScript",
        "title": "%cmd.executeScript%",
        "icon": "$(run-all)"
      },
      {
        "command": "dbexplorer.explainPlan",
        "title": "%cmd.explainPlan%",
        "icon": "$(graph)"
      },
      {
        "command": "dbexplorer.describe",
        "title": "%cmd.describe%"
      },
      {
        "command": "dbexplorer.commit",
        "title": "%cmd.commit%",
        "icon": "$(check)"
      },
      {
        "command": "dbexplorer.rollback",
        "title": "%cmd.rollback%",
        "icon": "$(discard)"
      },
      {
        "command": "dbexplorer.toggleAutoCommit",
        "title": "%cmd.toggleAutoCommit%"
      },
      {
        "command": "dbexplorer.cancel",
        "title": "%cmd.cancel%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "dbexplorer.history",
        "title": "%cmd.history%"
      },
      {
        "command": "dbexplorer.openDdl",
        "title": "%cmd.openDdl%"
      },
      {
        "command": "dbexplorer.selectData",
        "title": "%cmd.selectData%"
      },
      {
        "command": "dbexplorer.describeObject",
        "title": "%cmd.describeObject%"
      },
      {
        "command": "dbexplorer.copyName",
        "title": "%cmd.copyName%"
      },
      {
        "command": "dbexplorer.describeQuery",
        "title": "%cmd.describeQuery%",
        "icon": "$(symbol-field)"
      },
      {
        "command": "dbexplorer.showResults",
        "title": "%cmd.showResults%"
      },
      {
        "command": "dbexplorer.runRoutine",
        "title": "%cmd.runRoutine%"
      },
      {
        "command": "dbexplorer.history.open",
        "title": "%cmd.history.open%"
      },
      {
        "command": "dbexplorer.history.insert",
        "title": "%cmd.history.insert%"
      },
      {
        "command": "dbexplorer.history.run",
        "title": "%cmd.history.run%",
        "icon": "$(play)"
      },
      {
        "command": "dbexplorer.history.copy",
        "title": "%cmd.history.copy%"
      },
      {
        "command": "dbexplorer.history.delete",
        "title": "%cmd.history.delete%",
        "icon": "$(trash)"
      },
      {
        "command": "dbexplorer.history.clear",
        "title": "%cmd.history.clear%",
        "icon": "$(clear-all)"
      },
      {
        "command": "dbexplorer.suggest",
        "title": "%cmd.suggest%"
      },
      {
        "command": "dbexplorer.exportResults",
        "title": "%cmd.exportResults%",
        "icon": "$(export)"
      },
      {
        "command": "dbexplorer.importTns",
        "title": "%cmd.importTns%"
      },
      {
        "command": "dbexplorer.disconnectAll",
        "title": "%cmd.disconnectAll%",
        "icon": "$(close-all)"
      },
      {
        "command": "dbexplorer.toggleComment",
        "title": "%cmd.toggleComment%",
        "icon": "$(comment)"
      },
      {
        "command": "dbexplorer.toggleBlockComment",
        "title": "%cmd.toggleBlockComment%"
      },
      {
        "command": "dbexplorer.optimize",
        "title": "%cmd.optimize%",
        "icon": "$(lightbulb)"
      },
      {
        "command": "dbexplorer.compareQueries",
        "title": "%cmd.compareQueries%",
        "icon": "$(diff)"
      },
      {
        "command": "dbexplorer.codeActions",
        "title": "%cmd.codeActions%",
        "icon": "$(lightbulb)"
      },
      {
        "command": "dbexplorer.tree.filter",
        "title": "%cmd.tree.filter%",
        "icon": "$(filter)"
      },
      {
        "command": "dbexplorer.tree.clearFilter",
        "title": "%cmd.tree.clearFilter%",
        "icon": "$(filter-filled)"
      },
      {
        "command": "dbexplorer.queryGraph",
        "title": "%cmd.queryGraph%",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "dbexplorer.callGraph",
        "title": "%cmd.callGraph%",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "dbexplorer.tree.filterType",
        "title": "%cmd.tree.filterType%",
        "icon": "$(list-filter)"
      },
      {
        "command": "dbexplorer.erDiagram",
        "title": "%cmd.erDiagram%",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "dbexplorer.usedBy",
        "title": "%cmd.usedBy%"
      },
      {
        "command": "dbexplorer.usesWhat",
        "title": "%cmd.usesWhat%"
      },
      {
        "command": "dbexplorer.compareSchemas",
        "title": "%cmd.compareSchemas%",
        "icon": "$(git-compare)"
      },
      {
        "command": "dbexplorer.favorite.add",
        "title": "%cmd.favorite.add%",
        "icon": "$(star-add)"
      },
      {
        "command": "dbexplorer.favorite.open",
        "title": "%cmd.favorite.open%"
      },
      {
        "command": "dbexplorer.favorite.run",
        "title": "%cmd.favorite.run%",
        "icon": "$(play)"
      },
      {
        "command": "dbexplorer.favorite.rename",
        "title": "%cmd.favorite.rename%"
      },
      {
        "command": "dbexplorer.favorite.delete",
        "title": "%cmd.favorite.delete%",
        "icon": "$(trash)"
      },
      {
        "command": "dbexplorer.favorite.pick",
        "title": "%cmd.favorite.pick%",
        "icon": "$(star-full)"
      },
      {
        "command": "dbexplorer.tree.invalid",
        "title": "%cmd.tree.invalid%",
        "icon": "$(warning)"
      },
      {
        "command": "dbexplorer.tree.invalidOff",
        "title": "%cmd.tree.invalidOff%",
        "icon": "$(error)"
      },
      {
        "command": "dbexplorer.tree.group",
        "title": "%cmd.tree.group%",
        "icon": "$(organization)"
      },
      {
        "command": "dbexplorer.tree.ungroup",
        "title": "%cmd.tree.ungroup%",
        "icon": "$(list-tree)"
      },
      {
        "command": "dbexplorer.useSchema",
        "title": "%cmd.useSchema%",
        "icon": "$(account)"
      },
      {
        "command": "dbexplorer.recompile",
        "title": "%cmd.recompile%",
        "icon": "$(sync)"
      },
      {
        "command": "dbexplorer.dropRoutine",
        "title": "%cmd.dropRoutine%",
        "icon": "$(trash)"
      },
      {
        "command": "dbexplorer.recompileInvalid",
        "title": "%cmd.recompileInvalid%",
        "icon": "$(sync)"
      },
      {
        "command": "dbexplorer.toAnsiJoin",
        "title": "%cmd.toAnsiJoin%"
      },
      {
        "command": "dbexplorer.favorite.insert",
        "title": "%cmd.favorite.insert%"
      },
      {
        "command": "dbexplorer.sideTab.browser",
        "title": "%cmd.sideTab.browser%"
      },
      {
        "command": "dbexplorer.sideTab.connection",
        "title": "%cmd.sideTab.connection%"
      },
      {
        "command": "dbexplorer.findDuplicates",
        "title": "%cmd.findDuplicates%"
      },
      {
        "command": "dbexplorer.diagnoseDuplicates",
        "title": "%cmd.diagnoseDuplicates%"
      },
      {
        "command": "dbexplorer.actions",
        "title": "%cmd.actions%",
        "category": "DB Explorer"
      },
      {
        "command": "dbexplorer.insertSnippet",
        "title": "%cmd.insertSnippet%",
        "category": "DB Explorer"
      },
      {
        "command": "dbexplorer.saveSnippet",
        "title": "%cmd.saveSnippet%",
        "category": "DB Explorer"
      },
      {
        "command": "dbexplorer.toggleReadOnly",
        "title": "%cmd.toggleReadOnly%",
        "category": "DB Explorer",
        "icon": "$(lock)"
      },
      {
        "command": "dbexplorer.goToObject",
        "title": "%cmd.goToObject%",
        "category": "DB Explorer"
      },
      {
        "command": "dbexplorer.diagnostics",
        "title": "%cmd.diagnostics%",
        "category": "DB Explorer"
      },
      {
        "command": "dbexplorer.togglePin",
        "title": "%cmd.togglePin%",
        "category": "DB Explorer"
      },
      {
        "command": "dbexplorer.openTools",
        "title": "%cmd.openTools%",
        "category": "DB Explorer"
      },
      {
        "command": "dbexplorer.openHelp",
        "title": "%cmd.openHelp%",
        "category": "DB Explorer"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dbexplorer.addConnection",
          "when": "view == dbexplorer.connections",
          "group": "navigation@2"
        },
        {
          "command": "dbexplorer.setActive",
          "when": "view == dbexplorer.connections",
          "group": "2_connection@1"
        },
        {
          "command": "dbexplorer.changeSchema",
          "when": "view == dbexplorer.connections",
          "group": "2_connection@2"
        },
        {
          "command": "dbexplorer.refresh",
          "when": "view == dbexplorer.connections",
          "group": "navigation@4"
        },
        {
          "command": "dbexplorer.newEditor",
          "when": "view == dbexplorer.connections",
          "group": "navigation@3"
        },
        {
          "command": "dbexplorer.importTns",
          "when": "view == dbexplorer.connections",
          "group": "2_connection@4"
        },
        {
          "command": "dbexplorer.disconnectAll",
          "when": "view == dbexplorer.connections",
          "group": "2_connection@3"
        },
        {
          "command": "dbexplorer.tree.filter",
          "when": "view == dbexplorer.connections && !dbexplorer.treeFiltered",
          "group": "navigation@1"
        },
        {
          "command": "dbexplorer.tree.clearFilter",
          "when": "view == dbexplorer.connections && dbexplorer.treeFiltered",
          "group": "navigation@1"
        },
        {
          "command": "dbexplorer.tree.filterType",
          "when": "view == dbexplorer.connections",
          "group": "1_view@3"
        },
        {
          "command": "dbexplorer.compareSchemas",
          "when": "view == dbexplorer.connections",
          "group": "3_tools@1"
        },
        {
          "command": "dbexplorer.tree.invalid",
          "when": "view == dbexplorer.connections && !dbexplorer.treeInvalid",
          "group": "1_view@2"
        },
        {
          "command": "dbexplorer.tree.invalidOff",
          "when": "view == dbexplorer.connections && dbexplorer.treeInvalid",
          "group": "1_view@2"
        },
        {
          "command": "dbexplorer.tree.group",
          "when": "view == dbexplorer.connections && !dbexplorer.groupedSchemas",
          "group": "1_view@1"
        },
        {
          "command": "dbexplorer.tree.ungroup",
          "when": "view == dbexplorer.connections && dbexplorer.groupedSchemas",
          "group": "1_view@1"
        }
      ],
      "view/item/context": [
        {
          "command": "dbexplorer.connect",
          "when": "view == dbexplorer.connections && viewItem == conn",
          "group": "1_conn"
        },
        {
          "command": "dbexplorer.setActive",
          "when": "view == dbexplorer.connections && viewItem == conn.on",
          "group": "1_conn@1"
        },
        {
          "command": "dbexplorer.setActive",
          "when": "view == dbexplorer.connections && viewItem == conn.on",
          "group": "1_conn"
        },
        {
          "command": "dbexplorer.disconnect",
          "when": "view == dbexplorer.connections && viewItem =~ /^conn\\.(on|active)$/",
          "group": "1_conn"
        },
        {
          "command": "dbexplorer.changeSchema",
          "when": "view == dbexplorer.connections && viewItem =~ /^conn\\.(on|active)$/",
          "group": "1_conn@2"
        },
        {
          "command": "dbexplorer.changeSchema",
          "when": "view == dbexplorer.connections && viewItem =~ /^conn\\.(on|active)$/",
          "group": "1_conn"
        },
        {
          "command": "dbexplorer.newEditor",
          "when": "view == dbexplorer.connections && viewItem =~ /^conn\\.(on|active)$/",
          "group": "1_conn"
        },
        {
          "command": "dbexplorer.editConnection",
          "when": "view == dbexplorer.connections && viewItem =~ /^conn/",
          "group": "2_edit"
        },
        {
          "command": "dbexplorer.removeConnection",
          "when": "view == dbexplorer.connections && viewItem =~ /^conn/",
          "group": "2_edit"
        },
        {
          "command": "dbexplorer.openDdl",
          "when": "view == dbexplorer.connections && viewItem =~ /^obj/",
          "group": "1_obj"
        },
        {
          "command": "dbexplorer.selectData",
          "when": "view == dbexplorer.connections && viewItem =~ /^obj\\.(TABLE|VIEW|MATERIALIZED VIEW|SYNONYM)$/",
          "group": "1_obj"
        },
        {
          "command": "dbexplorer.describeObject",
          "when": "view == dbexplorer.connections && viewItem =~ /^obj\\.(TABLE|VIEW|MATERIALIZED VIEW|SYNONYM)$/",
          "group": "1_obj"
        },
        {
          "command": "dbexplorer.runRoutine",
          "when": "view == dbexplorer.connections && viewItem =~ /^obj\\.(PROCEDURE|FUNCTION|PACKAGE)$/",
          "group": "1_obj"
        },
        {
          "command": "dbexplorer.copyName",
          "when": "view == dbexplorer.connections && viewItem =~ /^obj/",
          "group": "2_misc"
        },
        {
          "command": "dbexplorer.disconnect",
          "when": "view == dbexplorer.connections && viewItem =~ /^conn\\.(on|active)$/",
          "group": "inline@1"
        },
        {
          "command": "dbexplorer.tree.clearFilter",
          "when": "view == dbexplorer.connections && viewItem == search.active",
          "group": "inline"
        },
        {
          "command": "dbexplorer.recompileInvalid",
          "when": "view == dbexplorer.connections && viewItem =~ /^(cat|schema|schema\\.current|conn\\.on|conn\\.active)$/",
          "group": "3_compile"
        },
        {
          "command": "dbexplorer.useSchema",
          "when": "view == dbexplorer.connections && viewItem == schema",
          "group": "inline"
        },
        {
          "command": "dbexplorer.useSchema",
          "when": "view == dbexplorer.connections && viewItem == schema",
          "group": "1_schema"
        },
        {
          "submenu": "dbexplorer.moreObj",
          "when": "view == dbexplorer.connections && viewItem =~ /^obj/",
          "group": "3_more"
        },
        {
          "command": "dbexplorer.togglePin",
          "when": "view == dbexplorer.connections && viewItem =~ /^conn/",
          "group": "2_edit"
        }
      ],
      "editor/title": [
        {
          "command": "dbexplorer.executeStatement",
          "when": "editorLangId == sql",
          "group": "navigation@1"
        },
        {
          "command": "dbexplorer.executeScript",
          "when": "editorLangId == sql",
          "group": "navigation@2"
        },
        {
          "command": "dbexplorer.commit",
          "when": "editorLangId == sql && dbexplorer.dirty",
          "group": "navigation@0"
        },
        {
          "command": "dbexplorer.rollback",
          "when": "editorLangId == sql && dbexplorer.dirty",
          "group": "navigation@0"
        },
        {
          "command": "dbexplorer.explainPlan",
          "when": "editorLangId == sql",
          "group": "navigation@5"
        },
        {
          "command": "dbexplorer.describeQuery",
          "when": "editorLangId == sql",
          "group": "1_more@6"
        },
        {
          "command": "dbexplorer.changeSchema",
          "when": "editorLangId == sql",
          "group": "1_more@7"
        },
        {
          "command": "dbexplorer.setActive",
          "when": "editorLangId == sql",
          "group": "1_more@8"
        },
        {
          "command": "dbexplorer.optimize",
          "when": "editorLangId == sql",
          "group": "1_more@9"
        },
        {
          "command": "dbexplorer.compareQueries",
          "when": "editorLangId == sql",
          "group": "1_more@10"
        },
        {
          "command": "dbexplorer.cancel",
          "when": "dbexplorer.running",
          "group": "navigation@0"
        }
      ],
      "editor/context": [
        {
          "command": "dbexplorer.executeStatement",
          "when": "editorLangId == sql",
          "group": "dbexplorer@1"
        },
        {
          "command": "dbexplorer.executeScript",
          "when": "editorLangId == sql",
          "group": "dbexplorer@2"
        },
        {
          "command": "dbexplorer.explainPlan",
          "when": "editorLangId == sql",
          "group": "dbexplorer@3"
        },
        {
          "command": "dbexplorer.codeActions",
          "when": "editorLangId == sql",
          "group": "dbexplorer@0"
        },
        {
          "submenu": "dbexplorer.moreEditor",
          "when": "editorLangId == sql",
          "group": "dbexplorer@5"
        }
      ],
      "dbexplorer.moreObj": [
        {
          "command": "dbexplorer.callGraph",
          "when": "view == dbexplorer.connections && viewItem =~ /^obj\\.(PROCEDURE|FUNCTION|PACKAGE)$/",
          "group": "1_explore"
        },
        {
          "command": "dbexplorer.erDiagram",
          "when": "view == dbexplorer.connections && viewItem =~ /^obj\\.(TABLE|VIEW|MATERIALIZED VIEW)$/",
          "group": "1_explore"
        },
        {
          "command": "dbexplorer.usedBy",
          "when": "view == dbexplorer.connections && viewItem =~ /^obj\\.(TABLE|VIEW|MATERIALIZED VIEW|SEQUENCE|PROCEDURE|FUNCTION|PACKAGE|TYPE|SYNONYM)$/",
          "group": "1_explore"
        },
        {
          "command": "dbexplorer.usesWhat",
          "when": "view == dbexplorer.connections && viewItem =~ /^obj\\.(TABLE|VIEW|MATERIALIZED VIEW|PROCEDURE|FUNCTION|PACKAGE|TRIGGER|TYPE)$/",
          "group": "1_explore"
        },
        {
          "command": "dbexplorer.recompile",
          "when": "view == dbexplorer.connections && viewItem =~ /^obj\\.(PACKAGE|PROCEDURE|FUNCTION|TRIGGER|VIEW|MATERIALIZED VIEW|TYPE|SYNONYM)$/",
          "group": "3_compile"
        },
        {
          "command": "dbexplorer.dropRoutine",
          "when": "view == dbexplorer.connections && viewItem =~ /^obj\\.(PACKAGE|PROCEDURE|FUNCTION|TRIGGER)$/",
          "group": "9_drop"
        },
        {
          "command": "dbexplorer.findDuplicates",
          "when": "view == dbexplorer.connections && viewItem =~ /^obj\\.(TABLE|VIEW|MATERIALIZED VIEW)$/",
          "group": "1_explore"
        }
      ],
      "dbexplorer.moreEditor": [
        {
          "command": "dbexplorer.describe",
          "when": "editorLangId == sql",
          "group": "dbexplorer@4"
        },
        {
          "command": "dbexplorer.describeQuery",
          "when": "editorLangId == sql",
          "group": "dbexplorer@5"
        },
        {
          "command": "dbexplorer.suggest",
          "when": "editorLangId == sql",
          "group": "dbexplorer@6"
        },
        {
          "command": "dbexplorer.exportResults",
          "when": "editorLangId == sql",
          "group": "dbexplorer@7"
        },
        {
          "command": "dbexplorer.toggleComment",
          "when": "editorLangId == sql",
          "group": "dbexplorer@8"
        },
        {
          "command": "dbexplorer.toggleBlockComment",
          "when": "editorLangId == sql",
          "group": "dbexplorer@9"
        },
        {
          "command": "dbexplorer.optimize",
          "when": "editorLangId == sql",
          "group": "dbexplorer@10"
        },
        {
          "command": "dbexplorer.compareQueries",
          "when": "editorLangId == sql",
          "group": "dbexplorer@11"
        },
        {
          "command": "dbexplorer.favorite.add",
          "when": "editorLangId == sql",
          "group": "dbexplorer@12"
        },
        {
          "command": "dbexplorer.toAnsiJoin",
          "when": "editorLangId == sql",
          "group": "dbexplorer@13"
        },
        {
          "command": "dbexplorer.diagnoseDuplicates",
          "when": "editorLangId == sql",
          "group": "dbexplorer@14"
        }
      ]
    },
    "keybindings": [
      {
