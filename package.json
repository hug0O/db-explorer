    "configuration": [
      {
        "id": "dbexplorer.exec",
        "title": "%cfg.group.exec%",
        "order": 1,
        "properties": {
          "dbexplorer.autoCommit": {
            "type": "boolean",
            "default": false,
            "description": "%cfg.autoCommit%"
          },
          "dbexplorer.pageSize": {
            "type": "number",
            "default": 500,
            "description": "%cfg.pageSize%"
          },
          "dbexplorer.showAllMaxRows": {
            "type": "number",
            "default": 100000,
            "minimum": 0,
            "description": "%cfg.showAllMaxRows%"
          },
          "dbexplorer.queryTimeoutSeconds": {
            "type": "number",
            "minimum": 0,
            "default": 600,
            "description": "%cfg.queryTimeoutSeconds%"
          },
          "dbexplorer.onScriptError": {
            "type": "string",
            "enum": [
              "ask",
              "continue",
              "stop"
            ],
            "default": "ask",
            "description": "%cfg.onScriptError%",
            "enumDescriptions": [
              "%cfg.onScriptError.ask%",
              "%cfg.onScriptError.continue%",
              "%cfg.onScriptError.stop%"
            ]
          },
          "dbexplorer.clearLogOnRun": {
            "type": "boolean",
            "default": false,
            "description": "%cfg.clearLogOnRun%"
          },
          "dbexplorer.enableDbmsOutput": {
            "type": "boolean",
            "default": true,
            "description": "%cfg.enableDbmsOutput%"
          },
          "dbexplorer.blankLineSeparatesStatements": {
            "type": "boolean",
            "default": true,
            "description": "%cfg.blankLineSeparatesStatements%"
          },
          "dbexplorer.rollbackOnTimeout": {
            "type": "boolean",
            "default": true,
            "description": "%cfg.rollbackOnTimeout%"
          },
          "dbexplorer.transactionTimeoutMinutes": {
            "type": "number",
            "minimum": 0,
            "default": 0,
            "description": "%cfg.transactionTimeoutMinutes%"
          },
          "dbexplorer.idleTimeoutMinutes": {
            "type": "number",
            "minimum": 0,
            "default": 30,
            "description": "%cfg.idleTimeoutMinutes%"
          },
          "dbexplorer.notifyUncommitted": {
            "type": "boolean",
            "default": true,
            "description": "%cfg.notifyUncommitted%"
          }
        }
      },
      {
        "id": "dbexplorer.safety",
        "title": "%cfg.group.safety%",
        "order": 2,
        "properties": {
          "dbexplorer.confirmOnProduction": {
            "type": "boolean",
            "default": true,
            "description": "%cfg.confirmOnProduction%"
          },
          "dbexplorer.previewAffectedRows": {
            "type": "boolean",
            "default": true,
            "description": "%cfg.previewAffectedRows%"
          },
          "dbexplorer.confirmRowsThreshold": {
            "type": "number",
            "default": 100,
            "minimum": 0,
            "description": "%cfg.confirmRowsThreshold%"
          }
        }
      },
      {
        "id": "dbexplorer.results",
        "title": "%cfg.group.results%",
        "order": 3,
        "properties": {
          "dbexplorer.dateFormat": {
            "type": "string",
            "default": "YYYY-MM-DD HH24:MI:SS",
            "description": "%cfg.dateFormat%"
          },
          "dbexplorer.timestampFormat": {
            "type": "string",
            "default": "YYYY-MM-DD HH24:MI:SS.FF3",
            "description": "%cfg.timestampFormat%"
          },
          "dbexplorer.csvSeparator": {
            "type": "string",
            "enum": [
              ";",
              ",",
              "\t"
            ],
            "enumDescriptions": [
              "%cfg.csv.semicolon%",
              "%cfg.csv.comma%",
              "%cfg.csv.tab%"
            ],
            "default": ";",
            "description": "%cfg.csvSeparator%"
          },
          "dbexplorer.compareMaxRows": {
            "type": "number",
            "minimum": 100,
            "default": 50000,
            "description": "%cfg.compareMaxRows%"
          }
        }
      },
      {
        "id": "dbexplorer.editor",
        "title": "%cfg.group.editor%",
        "order": 4,
        "properties": {
          "dbexplorer.keymap": {
            "type": "string",
            "enum": [
              "standard",
              "alt",
              "toad"
            ],
            "enumDescriptions": [
              "%cfg.keymap.standard%",
              "%cfg.keymap.alt%",
              "%cfg.keymap.toad%"
            ],
            "default": "standard",
            "description": "%cfg.keymap%"
          },
          "dbexplorer.snippets": {
            "type": "array",
            "default": [],
            "description": "%cfg.snippets%",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "body": {
                  "type": "string",
                  "description": "VS Code snippet syntax"
                }
              },
              "required": [
                "name",
                "body"
              ]
            }
          },
          "dbexplorer.prefetchMetadata": {
            "type": "boolean",
            "default": true,
            "description": "%cfg.prefetchMetadata%"
          },
          "dbexplorer.metadataConnection": {
            "type": "boolean",
            "default": true,
            "description": "%cfg.metadataConnection%"
          },
          "dbexplorer.colorEditors": {
            "type": "boolean",
            "default": true,
            "description": "%cfg.colorEditors%"
          },
          "dbexplorer.showEditorBadge": {
            "type": "boolean",
            "default": true,
            "description": "%cfg.showEditorBadge%"
          },
          "dbexplorer.connectionInWindowTitle": {
            "type": "boolean",
            "default": true,
            "description": "%cfg.connectionInWindowTitle%"
          },
          "dbexplorer.groupBySchema": {
            "type": "boolean",
            "default": false,
            "description": "%cfg.groupBySchema%"
          },
          "dbexplorer.maxTreeObjects": {
            "type": "number",
            "default": 5000,
            "description": "%cfg.maxTreeObjects%"
          },
          "dbexplorer.inlineErrors": {
            "type": "boolean",
            "default": true,
            "description": "%cfg.inlineErrors%"
          },
          "dbexplorer.liveChecks": {
            "type": "boolean",
            "default": true,
            "description": "%cfg.liveChecks%"
          }
        }
      },
      {
        "id": "dbexplorer.conn",
        "title": "%cfg.group.conn%",
        "order": 5,
        "properties": {
          "dbexplorer.tnsAdmin": {
            "type": "string",
            "default": "",
            "description": "%cfg.tnsAdmin%"
          },
          "dbexplorer.oracleClientLibDir": {
            "type": "string",
            "default": "",
            "description": "%cfg.oracleClientLibDir%"
          }
        }
      }
    ],
    "configurationDefaults": {
      "files.associations": {
        "*.pks": "sql",
        "*.pkb": "sql",
        "*.prc": "sql",
        "*.fnc": "sql",
        "*.trg": "sql",
        "*.pls": "sql",
        "*.plsql": "sql"
      },
      "[sql]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": false
        },
        "editor.suggestOnTriggerCharacters": true,
        "editor.wordBasedSuggestions": "off",
        "editor.snippetSuggestions": "inline",
        "editor.suggest.snippetsPreventQuickSuggestions": false,
        "editor.acceptSuggestionOnEnter": "smart",
        "editor.quickSuggestionsDelay": 10
      }
